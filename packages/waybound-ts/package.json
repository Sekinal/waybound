{
  "name": "waybound",
  "version": "0.4.0",
  "description": "Typed async Node.js client for waybound-daemon: out-of-band Chrome automation through OS accessibility APIs and native input.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sekinal/waybound.git",
    "directory": "packages/waybound-ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run build",
    "pretest": "tsc -p tsconfig.build.json && tsc -p tsconfig.json",
    "test": "node --test --test-timeout=60000 \"build-test/test/**/*.test.js\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
